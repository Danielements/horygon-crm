<Window x:Class="Horygon.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Horygon.Desktop" Title="HORYGON · AI Executive Assistant" Width="1440" Height="920" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" Foreground="{DynamicResource Primary}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><local:PageVisibility x:Key="Page"/><local:NavIcon x:Key="NavIcon"/><local:InverseBool x:Key="Not"/><BooleanToVisibilityConverter x:Key="Bool"/></Window.Resources>
 <Grid Background="{DynamicResource Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="18,28">
   <DockPanel><StackPanel DockPanel.Dock="Top" Margin="8,0,0,30"><StackPanel Orientation="Horizontal"><Path Width="28" Height="30" Margin="0,0,10,0" Stretch="Uniform" Stroke="{StaticResource Cyan}" StrokeThickness="2" Data="M 15,0 L 28,8 L 28,23 L 15,31 L 2,23 L 2,8 Z M 9,9 L 9,23 M 21,9 L 21,23 M 9,16 L 21,16"/><TextBlock Text="HORYGON" FontSize="23" FontWeight="Bold"/></StackPanel><TextBlock Text="AI EXECUTIVE ASSISTANT" FontSize="9" Foreground="{DynamicResource Secondary}" Margin="0,10,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Background="{DynamicResource Surface}" Padding="12" CornerRadius="8"><StackPanel><TextBlock Text="●  Archivio locale protetto" FontSize="12" Foreground="#22C55E"/><TextBlock Text="La posta resta sul server.&#10;Nessun invio senza approvazione." FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border><TextBlock Text="MVP 0.8.2  ·  Windows desktop" FontSize="10" Style="{StaticResource Muted}" Margin="8,16,0,0"/></StackPanel>
    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" FontSize="14"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Converter={StaticResource NavIcon}}" Width="26" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><TextBlock Text="{Binding}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid MaxWidth="400" HorizontalAlignment="Left" Width="320" VerticalAlignment="Center"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cerca nei messaggi locali" AutomationProperties.Name="Ricerca globale" Margin="0"/><TextBlock Text="Cerca mittente, oggetto, ordine…" IsHitTestVisible="False" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="{Binding Settings.Company}" FontWeight="SemiBold"/><TextBlock Text="{Binding AiStatus}" Foreground="{DynamicResource Secondary}" FontSize="11"/></StackPanel><Button Grid.Column="2" Content="↻  Sincronizza" Command="{Binding SyncCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Style="{StaticResource PrimaryButton}"/></Grid></Border>
   <Grid x:Name="WorkArea" Grid.Row="1" Margin="28,24,20,12">
    <!-- DASHBOARD -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Dashboard}"><StackPanel>
     <TextBlock Text="La tua giornata, sotto controllo." Style="{StaticResource Heading}"/><TextBlock Text="Una vista operativa costruita esclusivamente sul tuo archivio." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SCARICATE OGGI" Foreground="{DynamicResource Secondary}" FontSize="11"/><TextBlock Text="{Binding NewMailCount}" FontSize="38" Margin="0,12,0,0"/><TextBlock Text="messaggi nell'archivio" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PRIORITÀ ALTA / CRITICA" Foreground="#F59E0B" FontSize="11"/><TextBlock Text="{Binding UrgentCount}" FontSize="38" Margin="0,12,0,0"/><TextBlock Text="ancora da gestire" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ATTIVITÀ APERTE" Foreground="{DynamicResource Secondary}" FontSize="11"/><TextBlock Text="{Binding TaskCount}" FontSize="38" Margin="0,12,0,0"/><TextBlock Text="azioni da completare" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BOZZE DA RIVEDERE" Foreground="{StaticResource Cyan}" FontSize="11"/><TextBlock Text="{Binding DraftCount}" FontSize="38" Margin="0,12,0,0"/><Button Content="Apri approvazioni →" Command="{Binding NavigateCommand}" CommandParameter="Approvazioni" Padding="0,6" FontSize="11"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Padding="26"><StackPanel><TextBlock Text="✦  Executive Briefing" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Briefing}" FontSize="17" LineHeight="28" Margin="0,16,0,12"/><TextBlock Text="Riepilogo deterministico · conteggi verificabili dal database locale" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
     <TextBlock Text="Richiedono la tua attenzione" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,16"/>
     <ItemsControl ItemsSource="{Binding Critical}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding From}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Summary}"/><TextBlock Text="{Binding Analysis.Reason}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="#F59E0B" Margin="12,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Se non compaiono criticità, nessun messaggio non gestito ha priorità alta o critica. Gli ordini non verificati non vengono conteggiati come problemi reali." Style="{StaticResource Muted}"/><Button Content="Apri la posta →" Command="{Binding NavigateCommand}" CommandParameter="Posta in arrivo" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
    <!-- ROADMAP -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Roadmap}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/><RowDefinition Height="280"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,12"><TextBlock Text="Roadmap · richieste e attività" Style="{StaticResource Heading}"/>
      <TextBlock Text="Una riga per conversazione o accorpamento confermato · ordinata per ritardo e priorità · clic sulle intestazioni per ordinare" Style="{StaticResource Muted}"/>
      <WrapPanel><Button Content="Analizza email già scaricate" Command="{Binding AnalyzePendingCommand}"/><Button Content="Aggiorna stato" Command="{Binding RefreshAsyncCommandCommand}"/><TextBlock Text="Obiettivo risposta (ore solari)" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox Text="{Binding Settings.ResponseTargetHours}" Width="70"/><Button Content="Salva obiettivo" Command="{Binding SaveSettingsCommand}"/></WrapPanel>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Roadmap}" SelectedItem="{Binding SelectedRequest}" IsReadOnly="True" FrozenColumnCount="2" SelectionMode="Single" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="115"/><DataGridTextColumn Header="Ritardo" Binding="{Binding DelayLabel}" Width="100"/>
       <DataGridTextColumn Header="Priorità" Binding="{Binding Priority}" Width="90"/>
       <DataGridTextColumn Header="Richiesta" Binding="{Binding Title}" Width="220"/>
       <DataGridTextColumn Header="Risposta" Binding="{Binding Response}" Width="135"/>
       <DataGridTextColumn Header="Scadenza / attesa" Binding="{Binding Timing}" Width="245"/>
       <DataGridTextColumn Header="Ricevute" Binding="{Binding IncomingCount}" Width="75"/><DataGridTextColumn Header="Inviate" Binding="{Binding OutgoingCount}" Width="70"/>
       <DataGridTextColumn Header="Attività chiuse" Binding="{Binding TaskLabel}" Width="100"/>
       <DataGridTextColumn Header="Contatto" Binding="{Binding Contact}" Width="200"/>
       <DataGridTextColumn Header="Ordine" Binding="{Binding Orders}" Width="100"/>
       <DataGridTextColumn Header="Tipo posta" Binding="{Binding MailType}" Width="200"/><DataGridTextColumn Header="Coerenza" Binding="{Binding Coherence}" Width="210"/>
       <DataGridTextColumn Header="Ultima email" Binding="{Binding Latest, StringFormat=g}" Width="145"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0"><StackPanel>
        <TextBlock Text="{Binding SelectedRequest.Title}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SelectedRequest.Summary}" Style="{StaticResource Muted}" Margin="0,6"/>
        <TextBlock Text="{Binding SelectedRequest.Evidence}" Foreground="{StaticResource Cyan}"/><TextBlock Text="{Binding SelectedRequest.Coverage}" TextWrapping="Wrap" Foreground="{StaticResource Cyan}" Margin="0,5"/>
        <WrapPanel><TextBlock Text="Responsabile" VerticalAlignment="Center"/><TextBox Text="{Binding RequestOwner, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="8,4"/><TextBlock Text="Scadenza" VerticalAlignment="Center"/><DatePicker Foreground="Black" Background="White" SelectedDate="{Binding RequestDue}" Width="135" Margin="8,4"><DatePicker.Resources><Style TargetType="{x:Type DatePickerTextBox}"><Setter Property="Foreground" Value="Black"/><Setter Property="Background" Value="White"/></Style></DatePicker.Resources></DatePicker></WrapPanel>
        <WrapPanel><Button Content="In lavorazione" Command="{Binding UpdateRequestCommand}" CommandParameter="IN_PROGRESS"/><Button Content="In attesa" Command="{Binding UpdateRequestCommand}" CommandParameter="WAITING"/><Button Content="Chiudi attività" Command="{Binding UpdateRequestCommand}" CommandParameter="COMPLETED"/><Button Content="Riapri" Command="{Binding UpdateRequestCommand}" CommandParameter="OPEN"/></WrapPanel>
        <TextBlock Text="La chiusura riguarda tutte le attività collegate. Una nuova email ricevuta dopo la chiusura torna da verificare. Ritardi su ore solari o scadenze impostate; risposte rilevate solo nella posta sincronizzata." Style="{StaticResource Muted}" FontSize="11"/>
       </StackPanel></ScrollViewer>
       <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding SelectedRequest.Emails}" SelectedItem="{Binding SelectedRequestMail}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Date, StringFormat=g}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Button Grid.Row="1" Content="Apri email selezionata →" Command="{Binding OpenRequestMailCommand}" HorizontalAlignment="Left"/>
        <StackPanel Grid.Row="2"><ComboBox ItemsSource="{Binding Roadmap}" SelectedItem="{Binding MergeTarget}" DisplayMemberPath="Title" ToolTip="Scegli un'altra richiesta da accorpare"/><WrapPanel><Button Content="Accorpa selezionata" Command="{Binding MergeRequestCommand}"/><Button Content="Separa accorpamento" Command="{Binding SplitRequestCommand}"/></WrapPanel></StackPanel>
       </Grid>
      </Grid>
     </Border>
    </Grid>
    <!-- MAIL / SEARCH -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Posta in arrivo|Priorità AI|Ricerca}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding SelectedPage}" Style="{StaticResource Heading}"/><TextBlock Text="Ricerca globale in alto · categorie e stati restano locali · nessun contenuto remoto viene caricato" Style="{StaticResource Muted}"/><Button Content="Analizza email già scaricate" Command="{Binding AnalyzePendingCommand}" HorizontalAlignment="Left"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="300" MinWidth="210"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" FontSize="12"/>
      <Grid Grid.Column="1"><TextBlock Text="Nessun messaggio: sincronizza un account o modifica la ricerca." Style="{StaticResource Muted}" Margin="12" Visibility="{Binding Mails.Count, Converter={StaticResource Page}, ConverterParameter=0}"/><ListBox ItemsSource="{Binding Mails}" SelectedItem="{Binding SelectedMail}"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding PriorityLabel}" FontSize="10" Foreground="{StaticResource Cyan}"/><TextBlock Text="{Binding AttachmentLabel}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding From}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,4"/><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" MaxHeight="42"/><TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Secondary}" FontSize="12" MaxHeight="36" Margin="0,6"/><TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy HH:mm}}" Foreground="{DynamicResource Secondary}" FontSize="10"/><TextBlock Text="{Binding Folder}" FontSize="10" Foreground="{DynamicResource Secondary}"/><TextBlock Text="{Binding ClassificationLabel}" FontSize="10" Foreground="{StaticResource Cyan}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <GridSplitter Grid.Column="2" Width="3" Background="{DynamicResource Line}" HorizontalAlignment="Stretch"/>
      <ScrollViewer Grid.Column="3" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0"><StackPanel><TextBlock Text="{Binding SelectedMail.Subject, TargetNullValue=Seleziona un messaggio}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedMail.From}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedMail.To, StringFormat=A: {0}}" FontSize="12"/><TextBlock Text="{Binding SelectedMail.Cc, StringFormat=CC: {0}}" FontSize="12" Style="{StaticResource Muted}"/>
       <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding SelectedMail.ClassificationLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedMail.ClassificationDetails}" Style="{StaticResource Muted}"/><WrapPanel><Button Content="Posta ordinaria" Command="{Binding SetMailKindCommand}" CommandParameter="Regular"/><Button Content="Pubblicità" Command="{Binding SetMailKindCommand}" CommandParameter="Advertising"/><Button Content="Spam sospetto" Command="{Binding SetMailKindCommand}" CommandParameter="SuspectedSpam"/><Button Content="Automatico" Command="{Binding SetMailKindCommand}" CommandParameter="Auto"/></WrapPanel></StackPanel></Border>
       <WrapPanel Margin="0,10"><Button Content="Rispondi" Command="{Binding ReplyCommand}" CommandParameter="reply"/><Button Content="A tutti" Command="{Binding ReplyCommand}" CommandParameter="all"/><Button Content="Inoltra" Command="{Binding ReplyCommand}" CommandParameter="forward"/><Button Content="✦ Prepara risposta AI" Command="{Binding ReplyCommand}" CommandParameter="ai" Style="{StaticResource PrimaryButton}"/><Button Content="Analizza" Command="{Binding AnalyzeCommand}"/><Button Content="Crea attività" Command="{Binding CreateTaskCommand}"/><Button Content="Gestita / da gestire" Command="{Binding MarkHandledCommand}"/></WrapPanel>
       <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding SelectedMail.PriorityLabel}" Foreground="{StaticResource Cyan}" FontWeight="Bold"/><TextBlock Text="{Binding SelectedMail.Summary}" Margin="0,8"/><TextBlock Text="{Binding SelectedMail.Analysis.Reason}" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding SelectedMail.Analysis.Source, StringFormat=Fonte: {0}}" FontSize="11"/><TextBlock Text="{Binding SelectedMail.Analysis.SuggestedAction, StringFormat=Azione suggerita: {0}}" FontSize="11"/><TextBlock Text="{Binding SelectedMail.Analysis.Confidence, StringFormat=Indicatore modello (non probabilità): {0:F2}}" FontSize="11"/></StackPanel></Border>
       <TextBlock Text="MESSAGGIO · VISUALIZZAZIONE TESTUALE SICURA" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="0,0,0,10"/><TextBox Text="{Binding SelectedMail.Body, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" MinHeight="150"/>
       <ItemsControl ItemsSource="{Binding SelectedMail.Attachments}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" HorizontalContentAlignment="Left" Command="{Binding DataContext.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="Storico conversazione" Foreground="{DynamicResource Primary}" Margin="0,20"><TextBlock Text="{Binding Conversation}" Margin="0,12"/></Expander>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Tabellone task}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="180"/><RowDefinition Height="220"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,14"><TextBlock Text="TASK BOARD / ATTIVITÀ APERTE" FontFamily="Consolas" FontSize="25" FontWeight="Bold" Foreground="#FBBF24"/><TextBlock Text="Stato attività e ultimi eventi dalle email collegate · aggiornamento a ogni sincronizzazione · chiusura manuale" Style="{StaticResource Muted}"/>
      <WrapPanel><Button Content="Sincronizza ora" Command="{Binding SyncCommand}"/><Button Content="Aggiorna tabellone" Command="{Binding RefreshAsyncCommandCommand}"/><CheckBox Content="Sincronizzazione automatica" IsChecked="{Binding Settings.AutoSync}" VerticalAlignment="Center" Margin="12,0"/><TextBox Text="{Binding Settings.PollSeconds}" Width="65"/><TextBlock Text="secondi · app aperta" VerticalAlignment="Center" Margin="8,0"/><Button Content="Salva" Command="{Binding SaveSettingsCommand}"/></WrapPanel>
      <Border x:Name="BoardProgress" Background="#152131" CornerRadius="6" Padding="12" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}"><StackPanel>
       <TextBlock Text="AGGIORNAMENTO IN CORSO · i task già disponibili restano consultabili" Foreground="#FBBF24" FontFamily="Consolas" FontWeight="Bold"/>
       <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#E5E7EB" Margin="0,4"/>
       <ProgressBar Height="3" IsIndeterminate="True"/>
      </StackPanel></Border>
      <TextBlock Text="{Binding OpenTaskBoard.Count, StringFormat=Task aperti disponibili: {0}}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
     </StackPanel>
     <DataGrid x:Name="TaskBoardGrid" Grid.Row="1" ItemsSource="{Binding OpenTaskBoard}" SelectedItem="{Binding SelectedBoardTask}" IsReadOnly="True" SelectionMode="Single" FontFamily="Consolas" RowHeight="48" FrozenColumnCount="1" Background="#090D14" RowBackground="#101824" AlternatingRowBackground="#152131">
      <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#27476E"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTextColumn Header="CODICE" Binding="{Binding BoardCode}" Width="85"/><DataGridTextColumn Header="TASK" Binding="{Binding Title}" Width="250"/><DataGridTextColumn Header="STATO" Binding="{Binding State}" Width="115"/>
       <DataGridTemplateColumn Header="ULTIMO EVENTO EMAIL" Width="265"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MailStatus}" Foreground="#FBBF24" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding MailStatusDetail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="PRIORITÀ" Binding="{Binding Priority}" Width="95"/><DataGridTextColumn Header="SCADENZA" Binding="{Binding BoardTiming}" Width="180"/><DataGridTextColumn Header="RESPONSABILE" Binding="{Binding Owner}" Width="150"/><DataGridTextColumn Header="ULTIMA EMAIL" Binding="{Binding LastMailAt, StringFormat=g}" Width="160"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border x:Name="BoardEmpty" Grid.Row="1" Background="#101824" Margin="1,35,1,1" Padding="24" IsHitTestVisible="False" Visibility="{Binding OpenTaskBoard.Count, Converter={StaticResource Page}, ConverterParameter=0}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="550">
      <TextBlock FontSize="20" Foreground="#FBBF24" TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Nessun task aperto"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="Sto aggiornando il tabellone…"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="Durante il download vengono mostrati gli aggiornamenti disponibili circa ogni 5 secondi. Per aggiungere un task, apri una mail e premi Crea attività." TextWrapping="Wrap" TextAlignment="Center" Foreground="#CBD5E1" Margin="0,12"/>
     </StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding SelectedBoardTask.Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedBoardEvent.Detail}" TextWrapping="Wrap" MaxHeight="90" Margin="0,8"/><WrapPanel><Button Content="Apri email origine" Command="{Binding OpenBoardEmailCommand}"/><Button Content="Modifica task / scadenza" Command="{Binding EditBoardTaskCommand}"/><Button Content="Chiudi task" Command="{Binding CloseBoardTaskCommand}"/></WrapPanel><TextBlock Text="Segnali locali da verificare: nessuna modifica automatica a calendario o appuntamenti. Per task senza collegamenti, usa Crea attività dalla mail." Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
      <ListBox Grid.Column="1" ItemsSource="{Binding BoardHistory}" SelectedItem="{Binding SelectedBoardEvent}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Status}" Foreground="#FBBF24"/><TextBlock Text="{Binding MailDate, StringFormat=g}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></Border>
    </Grid>
    <!-- TASKS -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Attività}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Attività e scadenze" Style="{StaticResource Heading}"/><DockPanel Grid.Row="1" Margin="0,12"><Button DockPanel.Dock="Right" Content="Aggiungi attività" Command="{Binding AddTaskCommand}"/><TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Titolo della nuova attività"/></DockPanel>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Attività" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Priorità" Binding="{Binding Priority}" Width="100"/><DataGridTextColumn Header="Responsabile" Binding="{Binding Owner}" Width="130"/><DataGridTextColumn Header="Scadenza" Binding="{Binding Due, StringFormat=d}" Width="110"/></DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="3" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Filtra" Command="{Binding FilterTasksCommand}"/><TextBox Text="{Binding TaskSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cerca per titolo, ordine, responsabile o stato"/></DockPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Modifica attività selezionata" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedTask.Title, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><StackPanel Width="200" Margin="0,0,16,0"><TextBlock Text="Responsabile"/><TextBox Text="{Binding SelectedTask.Owner}"/></StackPanel><StackPanel Width="170" Margin="0,0,16,0"><TextBlock Text="Stato"/><ComboBox ItemsSource="{Binding TaskStates}" SelectedItem="{Binding SelectedTask.State}" Margin="0,6" Padding="6"/></StackPanel><StackPanel Width="150"><TextBlock Text="Scadenza"/><DatePicker SelectedDate="{Binding SelectedTask.Due}" Margin="0,6"/></StackPanel><Button Content="Salva attività" Command="{Binding SaveTaskCommand}" Margin="16,16,0,0"/></WrapPanel></StackPanel></Border></StackPanel>
    </Grid>
    <!-- APPROVALS -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Approvazioni}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="AI Approvals" Style="{StaticResource Heading}"/><TextBlock Text="Ogni invio richiede la tua conferma. Le bozze possono contenere errori: verifica fatti e destinatari." Style="{StaticResource Muted}"/></StackPanel><Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}"/><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0"><StackPanel><TextBlock Text="{Binding SelectedDraft.State, StringFormat=Stato: {0}}" Foreground="{StaticResource Cyan}" FontWeight="Bold"/><TextBlock Text="A"/><TextBox Text="{Binding SelectedDraft.To, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="CC"/><TextBox Text="{Binding SelectedDraft.Cc, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="BCC"/><TextBox Text="{Binding SelectedDraft.Bcc, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Oggetto"/><TextBox Text="{Binding SelectedDraft.Subject, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding SelectedDraft.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" VerticalScrollBarVisibility="Auto"/><ItemsControl ItemsSource="{Binding SelectedDraft.Attachments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Allega file" Command="{Binding AddAttachmentCommand}"/><Button Content="Salva bozza" Command="{Binding SaveDraftCommand}"/><Button Content="Rifiuta" Command="{Binding RejectDraftCommand}"/><Button Content="Approva e invia" Command="{Binding SendDraftCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBlock Text="Sent = accettato dal server. Uncertain/Sending = non reinviare: verificare presso il provider. La copia nella cartella Inviata dipende dal provider; Horygon conserva la copia locale." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></ScrollViewer></Grid></Grid>
    <!-- RULES -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Workflow}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Regole e comportamento" Style="{StaticResource Heading}"/><TextBlock Text="Le regole guidano l'AI. Non possono autorizzare invii o modifiche agli ordini." Style="{StaticResource Muted}"/></StackPanel><WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding RuleNames}" SelectedItem="{Binding RuleName}" Width="220" Margin="0,8,16,8" Padding="6"/><Button Content="Carica regola attiva" Command="{Binding LoadRuleCommand}"/><Button Content="Salva e attiva" Command="{Binding SaveRuleCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel><TextBox Grid.Row="2" Text="{Binding RuleText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><DockPanel Grid.Row="3"><Button DockPanel.Dock="Bottom" Content="Carica versione selezionata nell'editor" Command="{Binding PreviewRuleVersionCommand}"/><ListBox ItemsSource="{Binding RuleHistory}" SelectedItem="{Binding SelectedRuleVersion}"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding CreatedAt, StringFormat=g}"/><Run Text=" · "/><Run Text="{Binding Name}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Grid>
    <!-- AUDIT -->
    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Report}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Registro delle operazioni" Style="{StaticResource Heading}"/><TextBlock Text="Ultimi 500 eventi · audit locale cifrato · clic sulle intestazioni per ordinare" Style="{StaticResource Muted}"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Audit}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data" Binding="{Binding Timestamp, StringFormat=g}" Width="160"/><DataGridTextColumn Header="Azione" Binding="{Binding Action}" Width="190"/><DataGridTextColumn Header="Utente" Binding="{Binding Actor}" Width="100"/><DataGridTextColumn Header="Esito / motivazione" Binding="{Binding Result}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
    <!-- ORDERS -->
    <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Ordini}"><TextBlock Text="Ordini" Style="{StaticResource Heading}"/><Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Connettore non configurato" FontSize="22"/><TextBlock Text="Per consultare ordini reali servono l'indirizzo del portale, i domini autorizzati e i selettori dei campi. I componenti HTML e browser in sola lettura sono inclusi nel progetto; il collegamento al portale aziendale e la relativa schermata di configurazione non sono ancora disponibili in questo MVP." Style="{StaticResource Muted}"/><TextBlock Text="Nessuno stato ordine viene inventato. Aggiornamenti al portale non abilitati." Foreground="#F59E0B"/></StackPanel></Border></StackPanel>
    <!-- SETTINGS / FIRST START -->
    <ScrollViewer IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Impostazioni}"><StackPanel><TextBlock Text="Impostazioni" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Welcome}" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  ·  Account email" FontSize="20" FontWeight="SemiBold"/><WrapPanel Margin="0,12"><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Width="320" Padding="6" Margin="0,4,16,4"/><Button Content="Nuovo account" Command="{Binding NewAccountCommand}"/><Button Content="Gmail · Accedi con Google" Command="{Binding ApplyEmailPresetCommand}" CommandParameter="Gmail"/><Button Content="Usa Aruba" Command="{Binding ApplyEmailPresetCommand}" CommandParameter="Aruba"/></WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Indirizzo email"/><TextBox Text="{Binding EditingAccount.Address, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Server IMAP · SSL/TLS"/><TextBox Text="{Binding EditingAccount.ImapHost}"/><TextBlock Text="Porta IMAP"/><TextBox Text="{Binding EditingAccount.ImapPort}"/><TextBlock Text="Periodo iniziale, giorni (1–3650)"/><TextBox Text="{Binding EditingAccount.HistoryDays}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Metodo di autenticazione"/><ComboBox ItemsSource="{Binding MailAuthenticationOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding SelectedMailAuthentication}" Margin="0,4,0,10"/><StackPanel IsEnabled="{Binding IsGoogleAuthentication, Converter={StaticResource Not}}"><TextBlock Text="Password (non richiesta con Google OAuth)"/><PasswordBox local:SecretBinding.Enabled="True" local:SecretBinding.Value="{Binding EditingAccount.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><TextBlock Text="Server SMTP"/><TextBox Text="{Binding EditingAccount.SmtpHost}"/><TextBlock Text="Porta SMTP"/><TextBox Text="{Binding EditingAccount.SmtpPort}"/><CheckBox Content="SMTP STARTTLS (altrimenti SSL/TLS diretto)" IsChecked="{Binding EditingAccount.SmtpStartTls}"/></StackPanel></Grid><Border x:Name="GoogleOAuthCard" Background="{DynamicResource Background}" Padding="16" CornerRadius="6" Margin="0,8,0,14"><StackPanel>
 <TextBlock Text="Gmail aziendale · Accedi con Google" FontSize="18" FontWeight="SemiBold"/>
 <TextBlock Text="Non serve la password di Google. La prima configurazione richiede un client OAuth di tipo App desktop nella tua Google Cloud Console, distinto dal client web del CRM." Style="{StaticResource Muted}"/>
 <WrapPanel><Button Content="1 · Guida Google Cloud" Command="{Binding OpenGoogleOAuthGuideCommand}"/><Button Content="2 · Importa JSON OAuth desktop" Command="{Binding ImportGoogleClientCommand}"/></WrapPanel>
 <TextBlock Text="Client ID Google OAuth"/><TextBox Text="{Binding Settings.GoogleOAuthClientId, UpdateSourceTrigger=PropertyChanged}"/>
 <Expander Header="Client secret (compilato dall'importazione JSON)" Foreground="{DynamicResource Primary}"><PasswordBox local:SecretBinding.Enabled="True" local:SecretBinding.Value="{Binding Settings.GoogleOAuthClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Expander>
 <TextBlock Text="Per IMAP/SMTP Google richiede il permesso completo sulla posta. Horygon continua a scaricare in sola lettura e richiede sempre conferma prima dell'invio. L'amministratore Workspace potrebbe dover autorizzare questa app." Style="{StaticResource Muted}" Margin="0,12,0,8"/>
 <WrapPanel><Button Content="3 · Accedi con Google" Command="{Binding ConnectGoogleCommand}" IsEnabled="{Binding IsGoogleAuthentication}" Style="{StaticResource PrimaryButton}"/><Button Content="Scollega Google localmente" Command="{Binding DisconnectGoogleCommand}" IsEnabled="{Binding IsGoogleAuthentication}"/></WrapPanel>
 <TextBlock Text="{Binding GoogleConnectionStatus}" Foreground="{StaticResource Cyan}" Margin="0,8"/>
 <Expander Header="Alternativa: password per le app" Foreground="{DynamicResource Primary}"><StackPanel><TextBlock Text="Se il tuo account la consente, seleziona Password / password per le app e usa la password Google dedicata di 16 lettere. Non inserire la password normale." Style="{StaticResource Muted}"/><Button Content="Apri password per le app Google ↗" Command="{Binding OpenGoogleAppPasswordsCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
</StackPanel></Border><TextBlock Text="Cartella Posta inviata (facoltativa: vuoto = riconoscimento automatico)"/><TextBox Text="{Binding EditingAccount.SentFolderOverride}"/><TextBlock Text="La sincronizzazione scarica prima la Posta inviata, poi INBOX e le altre cartelle, entro il periodo configurato." Style="{StaticResource Muted}"/><TextBlock Text="Firma"/><TextBox Text="{Binding EditingAccount.Signature}" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><Button Content="Verifica connessione" Command="{Binding TestAccountCommand}"/><Button Content="Salva account" Command="{Binding SaveAccountCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel></StackPanel></Border>
     <Border x:Name="AiSettingsCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  ·  Intelligenza artificiale" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Provider da utilizzare" Margin="0,16,0,6"/>
      <ComboBox ItemsSource="{Binding AiProviders}" SelectedValuePath="Kind" DisplayMemberPath="Label" SelectedValue="{Binding SelectedAiProvider}" HorizontalAlignment="Left" Width="350"/>
      <TextBlock Text="{Binding AiProviderHint}" Style="{StaticResource Muted}" Margin="0,12,0,8"/>
      <CheckBox Content="Abilita analisi AI (disattivata: fallback deterministico locale)" IsChecked="{Binding Settings.AiEnabled}"/>
      <CheckBox Content="Autorizzo l'invio dei contenuti email al provider esterno selezionato" IsChecked="{Binding Settings.AllowExternalAi}"/>
      <TextBlock Text="Endpoint API"/><TextBox Text="{Binding ActiveAiProfile.Endpoint, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsOfficialAi}"/>
      <TextBlock Text="Nome esatto del modello"/><TextBox Text="{Binding ActiveAiProfile.Model, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{Binding AiKeyLabel}"/><PasswordBox local:SecretBinding.Enabled="True" local:SecretBinding.Value="{Binding ActiveAiProfile.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="Chiave cifrata e separata per ogni provider. Cambiare provider non sovrascrive le altre chiavi." Style="{StaticResource Muted}" FontSize="12"/>
      <StackPanel Visibility="{Binding IsAnthropic, Converter={StaticResource Bool}}"><TextBlock Text="Workspace ID Anthropic (facoltativo, dipende dalla chiave)"/><TextBox Text="{Binding ActiveAiProfile.WorkspaceId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="Temperature (solo LM/API compatibile)"/><TextBox Text="{Binding Settings.Temperature}"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Max output token (128–8192)"/><TextBox Text="{Binding Settings.MaxTokens}"/></StackPanel><StackPanel><TextBlock Text="Timeout, secondi (5–300)"/><TextBox Text="{Binding Settings.TimeoutSeconds}"/></StackPanel></UniformGrid>
      <WrapPanel><Button Content="Test provider selezionato" Command="{Binding TestAiCommand}"/><Button Content="Salva configurazione AI" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}"/></WrapPanel>
      <TextBlock Text="Il test invia solo un messaggio di prova. Limite per risposta configurabile; budget cumulativo e stima costi non ancora disponibili." Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="03  ·  Profilo e preferenze" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Nome azienda" Margin="0,16,0,0"/><TextBox Text="{Binding Settings.Company}"/><CheckBox Content="Sincronizza periodicamente mentre Horygon è aperto" IsChecked="{Binding Settings.AutoSync}"/><TextBlock Text="Intervallo polling, secondi (15–3600)"/><TextBox Text="{Binding Settings.PollSeconds}" Width="180" HorizontalAlignment="Left"/><CheckBox Content="Tema chiaro" IsChecked="{Binding Settings.LightTheme}"/><WrapPanel><Button Content="Salva impostazioni" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Personalizza regole →" Command="{Binding NavigateCommand}" CommandParameter="Workflow"/><Button Content="Avvia sincronizzazione →" Command="{Binding SyncCommand}"/></WrapPanel><TextBlock Text="Protezione costi: nessuna analisi alla riapertura. Sincronizzazione automatica solo download. Analisi manuali: massimo 10 nuove per avvio; copie già elaborate riutilizzano il risultato. L'archivio viene conservato senza cancellazione automatica in questo MVP." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="{DynamicResource Sidebar}" Padding="28,12"><StackPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Bool}}" Margin="0,0,0,8"/><Button Content="Annulla accesso Google" Command="{Binding CancelGoogleLoginCommand}" Visibility="{Binding IsGoogleConnecting, Converter={StaticResource Bool}}" HorizontalAlignment="Left"/><WrapPanel><Button Content="Pausa lavorazione" Command="{Binding PauseWorkCommand}" IsEnabled="{Binding IsWorking}"/><Button Content="Riprendi · max 10 nuove analisi" Command="{Binding ResumeWorkCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/><TextBlock Text="{Binding WorkStatus}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/></WrapPanel><TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource Secondary}"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
