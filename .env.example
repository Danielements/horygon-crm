PORT=3001
DB_PATH=./horygon.db
SESSION_SECRET=change_me

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Riconciliazione giornaliera di sicurezza delle fatture SdI (SMTS).
# Disabilitata di default: un job su canale fiscale non parte da solo.
# In firma manuale ogni esecuzione prepara richieste da firmare (fino a 2/giorno).
SDI_DAILY_RECONCILIATION_ENABLED=false
SDI_DAILY_RECONCILIATION_CRON=0 6 * * *
SDI_DAILY_RECONCILIATION_LOOKBACK_DAYS=7
# Overlap (giorni) con l'ultima riconciliazione completata. Vuoto = usa il lookback.
SDI_DAILY_RECONCILIATION_OVERLAP_DAYS=7
